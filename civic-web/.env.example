# FactEngine main page — server configuration. Copy to .env (never committed) or set in your host's dashboard.

PORT=3000

# --- The prompts (intellectual property). Provide each ONE of three ways; see server/prompts/README.md.
# 1) inline text            CIVIC_PROMPT_EXTRACT="..."      CIVIC_PROMPT_EVALUATE="..."      CIVIC_PROMPT_CHALLENGE="..."
# 2) path to a file         CIVIC_PROMPT_EXTRACT_FILE=/secure/extract.txt   (etc.)
# 3) a gitignored file in   server/prompts/extract.txt, evaluate.txt, challenge.txt

# --- Models and reasoning. Requests carry ONLY these: the model, the reasoning effort, the prompts
#     verbatim, web search on both steps (not a setting). No cap, no mode, no verbosity, no context size,
#     no fallback, no limit.
#     `npm run verify` reads the request bodies actually sent and fails if anything else appears.
CIVIC_MODEL=gpt-5.6-sol
CIVIC_EFFORT=xhigh                          # Sol's ladder: none, low, medium, high, xhigh, max (xhigh: the operator's of 5 October, as before 21 September)
CIVIC_REASONING_MODE=standard               # standard (or empty) sends no mode key; pro is GPT-5.6's pro reasoning mode (21 September to 5 October)
# CIVIC_EXTRACT_MODELS=gpt-5.6-sol          # per-step override; one id = no fallback
# CIVIC_EXTRACT_EFFORT=xhigh
# CIVIC_EXTRACT_REASONING_MODE=standard
# CIVIC_EVAL_MODELS=gpt-5.6-sol
# CIVIC_EVAL_EFFORT=xhigh
# CIVIC_EVAL_REASONING_MODE=standard
# CIVIC_EXTRACT_REASONING_SUMMARY=auto      # display only; blank = off
# The listing's provider: openai (unset), deepseek (4 October) or fireworks (5 October). On deepseek the listing goes
# to DeepSeek's own service (deepseek-flash, DEEPSEEK_API_KEY); on fireworks to the same model served from the US by
# Fireworks (accounts/fireworks/models/deepseek-v4p1-flash, FIREWORKS_API_KEY), with store: false and FactEngine's
# tool server for its searches. Either at effort CIVIC_EXTRACT_EFFORT (high unless set), never OpenAI's; no mode, no
# summary; the model's chain of thought never reaches the page. Determinations stay on OpenAI.
# CIVIC_EXTRACT_PROVIDER=deepseek        # never fireworks again (the operator, 5 October); the fallback is openai
# CIVIC_DEEPSEEK_BASE_URL=https://api.deepseek.com              # only the guard points these elsewhere
# CIVIC_FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# CIVIC_EVAL_REASONING_SUMMARY=auto
# CIVIC_MAX_SOURCE_CHARS=0                  # 0 = no limit of ours; the model's context window decides
# CIVIC_ALLOW_SOURCE_TRUNCATION=false
# Claims at a time. This one figure paces the page as well as a request carrying several claims, so
# changing it here (or in the host's dashboard) changes the pace with no release. Three since 22
# September, at effort max in mode pro; the check page's pacing row, after a run, is the figure to
# set it by.
CIVIC_EVAL_CONCURRENCY=10
# CIVIC_MAX_CLAIMS=10                       # the most one /api/evaluate request carries; the page sends one claim per request, so this bounds nothing it does
# How many of the claims found run without a press; the rest wait for the reader's checkbox. Ten
# unless set; 0 means every claim waits for the reader (the operator's choice of 1 October).
# CIVIC_AUTO_TEST_FIRST=0
CIVIC_EVAL_RETRIES=8

# --- Visual echo: a picture, not a determination. Fast model as requested; art-directed first.
CIVIC_IMAGE_MODELS=gpt-image-2.5-flare,gpt-image-2.5-sunburst,gpt-image-1.5,gpt-image-1-mini
CIVIC_IMAGE_QUALITY=high
CIVIC_IMAGE_SIZE=1024x1536
CIVIC_IMAGE_ENABLED=true
CIVIC_IMAGE_ART_DIRECTION=true
CIVIC_IMAGE_ART_DIRECTION_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.4-mini
CIVIC_IMAGE_ART_DIRECTION_EFFORT=low

# --- Reading links. A reader can paste a web address instead of text; the server fetches the page,
#     the PDF or the video's caption track and hands back the source's own words. Addresses inside a
#     private network are refused, so the server cannot be used to reach machines behind a firewall.
# CIVIC_ALLOW_PRIVATE_URLS=false            # development only; never true on a public server
# CIVIC_YOUTUBE_BASE=https://www.youtube.com  # the guard points this at its stand-in; never set it otherwise
# CIVIC_YOUTUBE_CLIENTS=ANDROID,TVHTML5,WEB_EMBEDDED_PLAYER,ANDROID_VR,IOS  # the doors of YouTube's player, in order
# A hosted transcript service, the last door for a video YouTube keeps from the server. Nothing is
# asked until an address and a key are both set; the key stays on the server. {id} is the video's id,
# {url} its address, {jobId} a job the service hands back while it makes the transcript.
# For Supadata (supadata.ai), the four values are:
#   CIVIC_TRANSCRIPT_URL=https://api.supadata.ai/v1/transcript?url={url}&text=true&mode=native
#   CIVIC_TRANSCRIPT_KEY=<the key from dash.supadata.ai>
#   CIVIC_TRANSCRIPT_HEADER=x-api-key
#   CIVIC_TRANSCRIPT_JOB_URL=https://api.supadata.ai/v1/transcript/{jobId}
# mode=native fetches the captions a video already has, one credit each. mode=auto also transcribes a
# video that has none, charged by the video's length, which is why it is not the default here.
# CIVIC_TRANSCRIPT_PREFIX stays empty unless a service wants Authorization: Bearer <key>, where it is
# set to Bearer and the space is added for you.
# CIVIC_TRANSCRIPT_URL=
# CIVIC_TRANSCRIPT_KEY=
# CIVIC_TRANSCRIPT_HEADER=x-api-key
# CIVIC_TRANSCRIPT_PREFIX=
# CIVIC_TRANSCRIPT_JOB_URL=
# A search service, asked only when a site turns FactEngine away, to find the same article republished
# elsewhere and other reports of the same story; the reader picks one. Nothing is asked until an
# address and a key are both set; the key stays on the server. The request is the shape of Exa's search:
#   CIVIC_SEARCH_URL=https://api.exa.ai/search
#   CIVIC_SEARCH_KEY=<the key from dashboard.exa.ai>
# CIVIC_SEARCH_HEADER is x-api-key unless set; CIVIC_SEARCH_PREFIX stays empty unless a service wants
# Authorization: Bearer <key>. CIVIC_SEARCH_RESULTS is the results asked of each search, 10 unless set
# (the count Exa's base price covers).
# CIVIC_SEARCH_URL=
# CIVIC_SEARCH_KEY=

# Sources as tools (server/tools). The model reaches FactEngine's tools through the gateway at /mcp: set
# its public address and a pass of your own making, and both requests to OpenAI name it beside web
# search. Either empty: OpenAI's requests are exactly as before. A listing on Fireworks names the gateway
# whatever these say, at CIVIC_TOOLS_URL or else the service's own address (Render's RENDER_EXTERNAL_URL)
# followed by /mcp, through a door of each listing's own in the address (/mcp/t/<door>, shut when the
# listing ends; Fireworks forwards no header, so no pass goes). The pass is FactEngine's credential for
# OpenAI's servers; each source's own key is its own setting, named in
# server/tools/adapters (the search verb is on when CIVIC_SEARCH_URL and CIVIC_SEARCH_KEY are set).
# CIVIC_TOOLS_URL=https://civic-c64i.onrender.com/mcp
# CIVIC_TOOLS_PASS=
# CIVIC_WEB_USD_PER_CALL=0   # what a read through FactEngine's own reader is booked at in the ledger

# --- Challenge: mechanics run; the OpenAI call is withheld until the challenge prompt is certified.
CIVIC_CHALLENGE_ENABLED=false

# --- Internal accounting (operator view; not a customer feature). Tokens are exact, dollars are estimates
#     from server/pricing.js. Each call is appended to data/ledger.jsonl (no claim text, no keys).
CIVIC_INTERNAL_ACCOUNTING=true
# CIVIC_LEDGER_FILE=/var/civic/ledger.jsonl
# CIVIC_PRICING_JSON={"gpt-5.6-sol":{"input":4,"cached":0.4,"output":20}}
CIVIC_WEB_SEARCH_USD_PER_CALL=0.01
CIVIC_IMAGE_USD_PER_IMAGE=0.02

# --- The key. FactEngine runs on this one and no other: a key offered by a browser is never accepted,
#     because a prompt run on someone else's key is a prompt handed to them. This file wins over a
#     variable of the same name in the environment.
OPENAI_API_KEY=sk-...
# The listing's key when CIVIC_EXTRACT_PROVIDER=deepseek: DeepSeek's own, the operator's, the same rules as above.
# DEEPSEEK_API_KEY=sk-...
# The listing's key when CIVIC_EXTRACT_PROVIDER=fireworks: Fireworks' own (app.fireworks.ai, API Keys), the same rules.
# FIREWORKS_API_KEY=fw_...


# --- Development only: point the OpenAI client at scripts/mock-openai.js
# OPENAI_BASE_URL=http://localhost:3999/v1

# The door (server/access.js, server/accounts.js; 5 October). Accounts are on unless CIVIC_ACCOUNTS=off: a reader signs
# up with an email and a password before anything runs, and starts with CIVIC_SIGNUP_GRANT_CENTS of credit; a test's
# price is held when it starts, charged when it is delivered, released when it is not. Off is for a laptop of one's own:
# then nothing needs a sign-in and nothing is charged to anyone. On Render, accounts need DATABASE_URL (below): without
# it the service does not start, since accounts in memory would vanish at every deploy.
# CIVIC_ACCOUNTS=off
CIVIC_SIGNUP_GRANT_CENTS=1000
# The operator's address, which the open form cannot take, and the SHA-256 of the one-time link's token that makes the
# operator's account (the link opens /account#claim=<token>&email=<address>; /check is that account's alone).
# CIVIC_OPERATOR_EMAILS=you@example.com
# CIVIC_OPERATOR_CLAIM=
# Flagged defaults, the operator's to change: the shortest password, a session's days, wrong passwords per email an hour
# before a wait, and how long a reset link lasts.
# CIVIC_PASSWORD_MIN_CHARS=8
# CIVIC_SESSION_DAYS=400
# CIVIC_SIGNIN_TRIES=10
# CIVIC_RESET_LINK_HOURS=24
# Off unless set: wrong passwords per address an hour, and sign-ups per address a day (the address Render's proxy reports).
# CIVIC_SIGNIN_TRIES_PER_ADDRESS=0
# CIVIC_SIGNUPS_PER_ADDRESS_PER_DAY=0

# --- Facts have a price; every user is measured (server/economics.js; the operator's program of 2 October, and
#     the list price of 6 October). Listing the claims is always free. Testing one costs the list price, said once
#     on the page above the claims, and a run's tier says how many of the claims the reader chooses on a document
#     are free: tier 1 none, 2 one, 3 two (and a 4 in the order three). The tiers rotate every CIVIC_TIER_HOURS in
#     CIVIC_TIER_ORDER, starting CIVIC_TIER_SHIFT tiers later each day so every tier meets every time of day; a run
#     keeps the tier it started under. The average cost of a determination is still measured over the last
#     CIVIC_PRICE_WINDOW_DAYS, for the check page alone, where the list price's coverage of that cost plus
#     CIVIC_PRICE_MARKUP_PERCENT is shown; it never sets the price. Nothing is charged in money yet: revenue is
#     booked at list price and marked not collected. Every figure is the operator's.
CIVIC_PRICING_ENABLED=true                  # false: the page as before, nothing priced or measured beyond the ledger
# CIVIC_LIST_PRICE_CENTS=125                # "each fact-check is $1.25" (the operator, 6 October); unset = nothing is priced
CIVIC_PRICE_MARKUP_PERCENT=25               # the check page's coverage figure only
CIVIC_PRICE_WINDOW_DAYS=7                   # the days the check page's measurement covers
# Read by nothing since 6 October, and named on the check page and at boot while still set: CIVIC_PRICE_START_CENTS,
# CIVIC_PRICE_MIN_SAMPLE (the measured price's start figure and sample).
CIVIC_CURRENCY=USD
CIVIC_TIER_HOURS=6
CIVIC_TIER_ORDER=1,2,3                      # "0, 1, or 2 answers, not 3" (the operator, 6 October); 1,2,3,4 brings three free back
CIVIC_TIER_SHIFT=1                          # 0 = a fixed clock (the same tier at the same hour every day)
# CIVIC_TIER_LOSS_GUARD_USD=                # the loss in one window that sends every new run to tier 1 until it is earned back; unset = off
# CIVIC_TIER_FIXED=                         # one tier for everyone, for when the data has spoken
# CIVIC_PRICING_NOTE=                       # a sentence under the prices, for instance that the beta is not charged
# The measurement's home: Render's Postgres (the service's DATABASE_URL, Render's own name for it), where the
# rows outlive every deploy. Without it the rows live in the instance's memory and reset when it restarts.
# CIVIC_DATABASE_SSL is auto unless set: verified TLS to a host with a dot in its name, none to an internal one;
# require, insecure or off say otherwise.
# DATABASE_URL=
# CIVIC_DATABASE_SSL=auto
# The pool to that database and how long a request waits for a connection: every determination opens a short
# transaction on its run's row, so ten readers pressing at once need ten connections or a wait; a wait that ran
# out lost the claim's price row (it ran unmeasured), so the wait is long. Settings, not figures of ours.
CIVIC_DATABASE_POOL=10
CIVIC_DATABASE_WAIT_MS=30000
# CIVIC_CLOCK=                              # the guard's clock (an ISO instant the server runs from); never set it otherwise
