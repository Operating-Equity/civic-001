# CIVIC main page — server configuration. Copy to .env (never committed) or set in your host's dashboard.

PORT=3000

# --- The prompts (intellectual property). Provide each ONE of three ways; see server/prompts/README.md.
# 1) inline text            CIVIC_PROMPT_EXTRACT="..."      CIVIC_PROMPT_EVALUATE="..."      CIVIC_PROMPT_CHALLENGE="..."
# 2) path to a file         CIVIC_PROMPT_EXTRACT_FILE=/secure/extract.txt   (etc.)
# 3) a gitignored file in   server/prompts/extract.txt, evaluate.txt, challenge.txt

# --- Models and reasoning. Requests carry ONLY these: the model, the reasoning effort, the prompts
#     verbatim, web search. No cap, no mode, no verbosity, no context size, no fallback, no limit.
#     `npm run verify` reads the request bodies actually sent and fails if anything else appears.
CIVIC_MODEL=gpt-5.6-sol
CIVIC_EFFORT=xhigh
# CIVIC_EXTRACT_MODELS=gpt-5.6-sol          # per-step override; one id = no fallback
# CIVIC_EXTRACT_EFFORT=xhigh
# CIVIC_EVAL_MODELS=gpt-5.6-sol
# CIVIC_EVAL_EFFORT=xhigh
# CIVIC_EXTRACT_REASONING_SUMMARY=auto      # display only; blank = off
# CIVIC_EVAL_REASONING_SUMMARY=auto
# CIVIC_EVAL_WEB_SEARCH=true
# CIVIC_MAX_SOURCE_CHARS=0                  # 0 = no limit of ours; the model's context window decides
# CIVIC_ALLOW_SOURCE_TRUNCATION=false
CIVIC_EVAL_CONCURRENCY=20
CIVIC_EVAL_RETRIES=8

# --- Visual echo: a picture, not a determination. Fast model as requested; art-directed first.
CIVIC_IMAGE_MODELS=gpt-image-2.5-flare,gpt-image-2.5-sunburst,gpt-image-1.5,gpt-image-1-mini
CIVIC_IMAGE_QUALITY=high
CIVIC_IMAGE_SIZE=1024x1024
CIVIC_IMAGE_ENABLED=true
CIVIC_IMAGE_ART_DIRECTION=true
CIVIC_IMAGE_ART_DIRECTION_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.4-mini
CIVIC_IMAGE_ART_DIRECTION_EFFORT=low

# --- Challenge: mechanics run; the OpenAI call is withheld until the challenge prompt is certified.
CIVIC_CHALLENGE_ENABLED=false

# --- Internal accounting (operator view; not a customer feature). Tokens are exact, dollars are estimates
#     from server/pricing.js. Each call is appended to data/ledger.jsonl (no claim text, no keys).
CIVIC_INTERNAL_ACCOUNTING=true
# CIVIC_LEDGER_FILE=/var/civic/ledger.jsonl
# CIVIC_PRICING_JSON={"gpt-5.6-sol":{"input":5,"cached":0.5,"output":30}}
CIVIC_WEB_SEARCH_USD_PER_CALL=0.01
CIVIC_IMAGE_USD_PER_IMAGE=0.02

# --- Optional server-side key (the operator pays; readers need no key). Off by default.
# CIVIC_ALLOW_SERVER_KEY=true
# OPENAI_API_KEY=sk-...


# --- Development only: point the OpenAI client at scripts/mock-openai.js
# OPENAI_BASE_URL=http://localhost:3999/v1
